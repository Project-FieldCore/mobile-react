{
  "expo": {
    "name": "FieldOps",
    "slug": "fieldops-mobile",
    "scheme": "fieldops-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fieldcore-app-icon.png",
    "splash": {
      "image": "./assets/fieldcore-app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#152A4E"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.projectfieldcore.fieldops",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#152A4E",
        "foregroundImage": "./assets/fieldcore-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o FieldOps use a câmera para identificar equipamentos.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o FieldOps registre sua localização ao iniciar a inspeção."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o FieldOps use o Face ID para desbloquear o aplicativo neste aparelho."
        }
      ],
      "expo-notifications",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "94ab1ae1-9e41-46c0-aa60-e37df0184bd6"
      }
    },
    "owner": "juliananascimento"
  }
}
